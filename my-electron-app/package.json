{
  "name": "meal_choice_y2k",
  "version": "1.0.0",
  "description": "Let council choose your meal",
  "license": "ISC",
  "author": "",
  "type": "commonjs",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "seed": "node scripts/seedDatabase.js",
    "test": "echo \"Error: no test specified\" && exit 1",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac"
  },
  "build": {
    "appId": "com.foodselection.app",
    "productName": "Meal Choice y2k",
    "mac": {
        "target": ["dmg"],
        "icon": "src/renderer/assets/images/icon.icns"
    },
    "extraResources": [
        {
            "from": "recommendation_engine",
            "to": "recommendation_engine"
        },
        {
            "from": "data",
            "to": "data"
        }
    ],
    "files": [
        "src/**/*",
        "package.json"
    ]
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.18.0",
    "electron-reload": "^2.0.0-alpha.1"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "csv-parse": "^7.0.3"
  }
}
